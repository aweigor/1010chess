# Frontend configuration — injected into index.html at container start
#
# BASE_URL: origin of the API server
#   ""                      → same origin (nginx on the server proxies /api/* to backend)
#   "https://api.example.com" → explicit cross-origin API host
BASE_URL=

# API_PATH: path prefix for all API routes on the backend
#   Must match the prefix registered in the Go server (default: /api)
API_PATH=/api
